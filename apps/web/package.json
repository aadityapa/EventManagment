{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "cache:clean": "node -e \"const fs=require('fs');const paths=['.next','node_modules/.cache'];for(const p of paths){try{fs.rmSync(p,{recursive:true,force:true});console.log('removed',p)}catch(e){}}\"",
    "media:sync": "npx tsx scripts/sync-media.ts",
    "media:sync:safe": "npx tsx scripts/sync-media.ts",
    "media:regen": "npx tsx scripts/regen-brand-images.ts",
    "brand:hero-og": "npx tsx scripts/build-hero-og.ts",
    "brand:icons": "node scripts/generate-brand-assets.mjs",
    "brand:og": "npx tsx scripts/build-og.mjs",
    "media:covers": "npx tsx scripts/export-covers.mjs",
    "media:drive-checklist": "npx tsx scripts/list-local-images-for-drive.ts",
    "prebuild": "node scripts/prebuild.mjs",
    "vercel-build": "npm run build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "optimize-images": "node scripts/optimize-images.mjs",
    "optimize-placeholders": "node scripts/optimize-placeholders.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^9.47.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
