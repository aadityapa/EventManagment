# Google Drive media library (production image source)
# Folder: https://drive.google.com/drive/folders/1UZR_UhiZfVvcLUNvDJi3Rvw8udkfKgYM
MEDIA_PROVIDER="google-drive"
GOOGLE_DRIVE_FOLDER_ID="1UZR_UhiZfVvcLUNvDJi3Rvw8udkfKgYM"
# API key with Drive API enabled (folder must be "Anyone with the link can view")
GOOGLE_DRIVE_API_KEY=""
# Live sync: site auto-refreshes from Drive every MEDIA_REVALIDATE_SECONDS (default 120)
MEDIA_LIVE_SYNC="1"
MEDIA_REVALIDATE_SECONDS="120"
# Vercel Cron auth for /api/cron/media-sync (set in Vercel dashboard)
CRON_SECRET=""
# Optional: service account JSON (single line) — share the Drive folder with client_email
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Website inquiries (/api/inquiry) — configure AT LEAST ONE or leads fall back
# to WhatsApp only. Webhook receives JSON (Google Apps Script → Sheet, Zapier,
# Make, Slack, CRM). Resend sends an email per inquiry.
INQUIRY_WEBHOOK_URL=
RESEND_API_KEY=
INQUIRY_EMAIL_TO=
INQUIRY_EMAIL_FROM=

# Express API: OTP login stays disabled unless explicitly enabled (see server/src/routes/auth.ts)
OTP_LOGIN_ENABLED=

# Database seed (prisma/seed.ts) — admin account; a random password is printed once if blank.
# SEED_ALLOW_PROD=1 is required to seed with NODE_ENV=production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_ALLOW_PROD=

